// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum ReviewStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProgrammingLanguage {
  JAVA
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  C
  CPP
  CSHARP
  GO
  RUST
  PHP
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ReportFormat {
  PDF
  MARKDOWN
  JSON
  CSV
}

enum ReportTemplateType {
  STANDARD
  EXECUTIVE_SUMMARY
  TECHNICAL
  INTERVIEW
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String?
  username        String?          @unique
  avatarUrl       String?
  bio             String?
  company         String?
  location        String?
  website         String?
  timeZone        String?          @default("UTC")
  language        String?          @default("en")
  dateFormat      String?          @default("YYYY-MM-DD")
  timeFormat      String?          @default("24h")
  role            Role             @default(USER)
  status          UserStatus       @default(PENDING_VERIFICATION)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  refreshTokens   RefreshToken[]
  sessions        UserSession[]
  apiKeys         UserApiKey[]
  auditLogs       AuditLog[]
  activities      Activity[]
  reviews         Review[]
  favoriteReviews FavoriteReview[]
  chatSessions    ChatSession[]
  preferences     UserPreference?
  reports         Report[]
  sharedReports   SharedReport[]
  updatedSettings SystemSetting[]
  workspaces      Workspace[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark")
  defaultAIProvider    String   @default("gemini")
  notificationsEnabled Boolean  @default(true)
  appearance           Json?
  editor               Json?
  ai                   Json?
  notifications        Json?
  privacy              Json?
  security             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@map("user_preferences")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  browser      String
  os           String
  ipAddress    String
  location     String?
  isCurrent    Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model UserApiKey {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keyHint     String
  keyHash     String
  permissions String[]  @default(["*"])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  status      String    @default("ACTIVE")

  @@index([userId])
  @@map("user_api_keys")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String // Token family UUID to detect token reuse attacks
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([family])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  action    String // e.g. AUTH_REGISTER, AUTH_LOGIN, AUTH_REFRESH, AUTH_LOGOUT, USER_UPDATE, USER_CHANGE_PASSWORD, ADMIN_USER_STATUS_UPDATE, ADMIN_USER_DELETE
  resource  String?
  ipAddress String?
  userAgent String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Review {
  id               String           @id @default(uuid())
  title            String
  description      String?          @db.Text
  repository       String?
  branch           String?
  status           ReviewStatus     @default(PENDING)
  score            Int? // 0-100 Quality Score
  summary          String?          @db.Text
  explanation      String?          @db.Text // AI structural code explanation
  timeComplexity   String?
  spaceComplexity  String?
  aiProvider       String           @default("gemini")
  aiModel          String?
  processingTimeMs Int?
  confidenceScore  Float?           @default(0.95) // 0.0 to 1.0 AI confidence level
  promptVersion    String?          @default("v1.0")
  promptTokens     Int?             @default(0)
  completionTokens Int?             @default(0)
  totalTokens      Int?             @default(0)
  rawResponse      String?          @db.Text
  creatorId        String
  creator          User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  parentReviewId   String?
  parentReview     Review?          @relation("ReviewReAnalysis", fields: [parentReviewId], references: [id], onDelete: SetNull)
  reAnalyses       Review[]         @relation("ReviewReAnalysis")
  chatSessions     ChatSession[]
  workspaceId      String?
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  files            ReviewFile[]
  favorites        FavoriteReview[]
  reports          Report[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewFile {
  id           String              @id @default(uuid())
  reviewId     String
  review       Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  filename     String
  content      String              @db.Text
  language     ProgrammingLanguage
  fileSize     Int                 @default(0)
  storagePath  String?
  improvedCode String?             @db.Text
  issues       Issue[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([reviewId])
  @@index([language])
  @@map("review_files")
}

model Issue {
  id              String     @id @default(uuid())
  fileId          String
  file            ReviewFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  line            Int
  severity        Severity
  category        String // e.g. SECURITY, COMPLEXITY, STYLE, BUG, PERFORMANCE
  message         String     @db.Text
  suggestion      String?    @db.Text
  confidenceScore Float?     @default(1.0)
  createdAt       DateTime   @default(now())

  @@index([fileId])
  @@index([severity])
  @@map("issues")
}

model FavoriteReview {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([userId])
  @@index([reviewId])
  @@map("favorite_reviews")
}

model ChatSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId    String?
  review      Review?       @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  title       String
  isPinned    Boolean       @default(false)
  aiProvider  String        @default("gemini")
  aiModel     String?
  totalTokens Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  messages    ChatMessage[]

  @@index([userId])
  @@index([reviewId])
  @@index([userId, isPinned])
  @@index([deletedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id               String           @id @default(uuid())
  sessionId        String
  session          ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String           @db.Text
  promptTokens     Int?             @default(0)
  completionTokens Int?             @default(0)
  totalTokens      Int?             @default(0)
  processingTimeMs Int?
  modelUsed        String?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  attachments      ChatAttachment[]

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([deletedAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileId    String?
  filename  String?
  lineStart Int?
  lineEnd   Int?
  snippet   String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([messageId])
  @@map("chat_attachments")
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. REGISTER, LOGIN, CREATE_REVIEW, FAVORITE_REVIEW, CHAT_MESSAGE
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("activities")
}

model Report {
  id            String             @id @default(uuid())
  reviewId      String
  review        Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  format        ReportFormat       @default(PDF)
  templateType  ReportTemplateType @default(STANDARD)
  status        ReportStatus       @default(COMPLETED)
  version       Int                @default(1)
  content       String             @db.Text
  downloadCount Int                @default(0)
  fileUrl       String?
  fileSize      Int?
  expiresAt     DateTime?
  sharedReports SharedReport[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  @@index([reviewId])
  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("reports")
}

model ReportTemplate {
  id          String             @id @default(uuid())
  name        String
  type        ReportTemplateType @unique
  description String?            @db.Text
  config      String             @db.Text
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type])
  @@index([isDefault])
  @@map("report_templates")
}

model SharedReport {
  id             String    @id @default(uuid())
  reportId       String
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  token          String    @unique
  accessCount    Int       @default(0)
  isRevoked      Boolean   @default(false)
  expiresAt      DateTime
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?

  @@index([token])
  @@index([reportId])
  @@index([createdById])
  @@index([isRevoked])
  @@map("shared_reports")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?          @db.Text
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([name])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isPublic])
  @@map("system_settings")
}

model Workspace {
  id          String          @id @default(uuid())
  name        String
  description String?         @db.Text
  repository  String?
  branch      String?         @default("main")
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       WorkspaceFile[]
  reviews     Review[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@map("workspaces")
}

model WorkspaceFile {
  id          String              @id @default(uuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename    String
  path        String
  content     String              @db.Text
  language    ProgrammingLanguage @default(TYPESCRIPT)
  fileSize    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId])
  @@map("workspace_files")
}

